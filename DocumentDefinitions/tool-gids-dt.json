{
  "BuildPath": "build/Toolgids/",
  "OutputFormats": {
    "html": {
      "InputFile": "DocumentDefinitions/Toolgids/ICTU-Toolgids-DT.md",
      "OutputFile": "ICTU-Toolgids-DT.html",
      "OutputPaths": ["docs/$VERSIE$/Toolgids/DT"],
      "StyleSheets": ["../../ICTU-Kwaliteitsaanpak.css", "../../ICTU-Navigatiemenu.css"],
      "CopyFiles": [
        {
          "from": "DocumentDefinitions/Shared/document.css",
          "to": "docs/$VERSIE$/ICTU-Kwaliteitsaanpak.css"
        },
        {
          "from": "DocumentDefinitions/Shared/navigation.css",
          "to": "docs/$VERSIE$/ICTU-Navigatiemenu.css"
        },
        {
          "from": "Content/Toolgids/DT/Images/*.png",
          "to": "docs/$VERSIE$/Toolgids/DT/Images"
        },
        {
          "from": "Content/Images/*.png",
          "to": "docs/$VERSIE$/Toolgids/DT"
        }
      ]
    }
  },
  "VariablesFiles": [
    "DocumentDefinitions/Shared/variables.json",
    "DocumentDefinitions/Toolgids/variables-toolgids-dt.json"
  ]
}
