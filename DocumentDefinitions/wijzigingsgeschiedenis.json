{
    "BuildPath": "build/Wijzigingsgeschiedenis/",
    "OutputFormats": {
        "html": {
            "InputFile": "DocumentDefinitions/Kwaliteitsaanpak/ICTU-Kwaliteitsaanpak-Wijzigingsgeschiedenis.md",
            "OutputFile": "ICTU-Kwaliteitsaanpak-Wijzigingsgeschiedenis.html",
            "OutputPaths": [
                "docs/$VERSIE$"
            ],
            "StyleSheets": [
                "ICTU-Kwaliteitsaanpak.css",
                "ICTU-Navigatiemenu.css"
            ],
            "CopyFiles": [
                {
                    "from": "DocumentDefinitions/Shared/document.css",
                    "to": "docs/$VERSIE$/ICTU-Kwaliteitsaanpak.css"
                },
                {
                    "from": "DocumentDefinitions/Shared/navigation.css",
                    "to": "docs/$VERSIE$/ICTU-Navigatiemenu.css"
                },
                {
                    "from": "Content/Images/*.png",
                    "to": "docs/$VERSIE$"
                }
            ]
        }
    },
    "VariablesFiles": [
        "DocumentDefinitions/Shared/variables.json"
    ]
}
