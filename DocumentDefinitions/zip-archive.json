{
    "BuildPath": "build/",
    "OutputFormats": {
        "zip": {
            "InputPaths": [
                "docs/$VERSIE$/*.css",
                "docs/$VERSIE$/*.docx",
                "docs/$VERSIE$/*.html",
                "docs/$VERSIE$/*.json",
                "docs/$VERSIE$/*.png",
                "docs/$VERSIE$/*.pptx",
                "docs/$VERSIE$/*.xlsx",
                "docs/$VERSIE$/Toolgids/*.css",
                "docs/$VERSIE$/Toolgids/*/*.html",
                "docs/$VERSIE$/Toolgids/*/*.png",
                "docs/$VERSIE$/Toolgids/*/Images/*.png"
            ],
            "OutputFile": "ICTU-Kwaliteitsaanpak.zip",
            "OutputPaths": [
                "docs/$VERSIE$"
            ]
        }
    },
    "VariablesFiles": [
        "DocumentDefinitions/Shared/variables.json"
    ]
}
